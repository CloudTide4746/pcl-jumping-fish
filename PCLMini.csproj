    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Product>PCL-跳跳鱼小队专用版</Product>
